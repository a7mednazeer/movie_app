  "faqASignIn": "Go to Profile and tap the sign-in banner, or Profile → your account area if you're already set up. Sign-up just needs a name, email, and password.",
  "@faqASignIn": {
    "description": "Help Center string: faqASignIn."
  },
  "faqQSyncDevices": "How does syncing across devices work?",
  "@faqQSyncDevices": {
    "description": "Help Center string: faqQSyncDevices."
  },
  "faqASyncDevices": "Once you're signed in, your watchlist and favorites automatically sync to your account and update in real time on any other device signed into the same account.",
  "@faqASyncDevices": {
    "description": "Help Center string: faqASyncDevices."
  },
  "faqQOffline": "Does the app work offline?",
  "@faqQOffline": {
    "description": "Help Center string: faqQOffline."
  },
  "faqAOffline": "Your watchlist and favorites are always available offline since they're stored on your device. Browsing new movies needs an internet connection.",
  "@faqAOffline": {
    "description": "Help Center string: faqAOffline."
  },
  "faqQChangeLanguage": "How do I change the app's language?",
  "@faqQChangeLanguage": {
    "description": "Help Center string: faqQChangeLanguage."
  },
  "faqAChangeLanguage": "Go to Settings → Language and pick from 12 supported languages, or choose System Default to follow your device's language.",
  "@faqAChangeLanguage": {
    "description": "Help Center string: faqAChangeLanguage."
  },
  "faqQChangeTheme": "How do I switch between light and dark mode?",
  "@faqQChangeTheme": {
    "description": "Help Center string: faqQChangeTheme."
  },
  "faqAChangeTheme": "Go to Settings → Appearance and choose Light, Dark, or Auto to follow your device's setting.",
  "@faqAChangeTheme": {
    "description": "Help Center string: faqAChangeTheme."
  },
  "faqQWatchTrailer": "How do I watch a trailer?",
  "@faqQWatchTrailer": {
    "description": "Help Center string: faqQWatchTrailer."
  },
  "faqAWatchTrailer": "Open a movie's details page and tap Watch Trailer. It opens in YouTube if a trailer is available for that title.",
  "@faqAWatchTrailer": {
    "description": "Help Center string: faqAWatchTrailer."
  },
  "faqQDeleteAccount": "How do I delete my account?",
  "@faqQDeleteAccount": {
    "description": "Help Center string: faqQDeleteAccount."
  },
  "faqADeleteAccount": "Go to Profile → Edit Profile and scroll to Delete Account. This permanently removes your account; your watchlist and favorites stay on your device but stop syncing.",
  "@faqADeleteAccount": {
    "description": "Help Center string: faqADeleteAccount."
  },
