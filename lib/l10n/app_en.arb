  },
  "privacyTitle": "Privacy Policy",
  "@privacyTitle": {
    "description": "Help Center string: privacyTitle."
  },
  "legalLastUpdated": "Last updated: January 2026",
  "@legalLastUpdated": {
    "description": "Help Center string: legalLastUpdated."
  },
  "termsSection1Title": "1. Acceptance of Terms",
  "@termsSection1Title": {
    "description": "Help Center string: termsSection1Title."
  },
  "termsSection1Body": "By using this app, you agree to these Terms of Service. If you don't agree, please don't use the app.",
  "@termsSection1Body": {
    "description": "Help Center string: termsSection1Body."
  },
  "termsSection2Title": "2. The Service",
  "@termsSection2Title": {
    "description": "Help Center string: termsSection2Title."
  },
  "termsSection2Body": "This app lets you browse, search, and save movie information sourced from The Movie Database (TMDB). We don't host, stream, or distribute any video content ourselves.",
  "@termsSection2Body": {
    "description": "Help Center string: termsSection2Body."
  },
  "termsSection3Title": "3. Accounts",
  "@termsSection3Title": {
    "description": "Help Center string: termsSection3Title."
  },
  "termsSection3Body": "You can use most features as a guest without an account. Creating an account (email and password, via Firebase Authentication) enables syncing your watchlist and favorites across your devices. You're responsible for keeping your password secure.",
  "@termsSection3Body": {
    "description": "Help Center string: termsSection3Body."
  },
  "termsSection4Title": "4. Your Content",
  "@termsSection4Title": {
    "description": "Help Center string: termsSection4Title."
  },
  "termsSection4Body": "Your watchlist, favorites, profile name, and photo URL are yours. We store them to provide the service and don't sell them or use them for advertising.",
  "@termsSection4Body": {
    "description": "Help Center string: termsSection4Body."
  },
  "termsSection5Title": "5. Third-Party Data",
  "@termsSection5Title": {
    "description": "Help Center string: termsSection5Title."
  },
  "termsSection5Body": "Movie titles, posters, ratings, cast, and reviews are provided by TMDB and may be inaccurate or change without notice. This product uses the TMDB API but is not endorsed or certified by TMDB.",
  "@termsSection5Body": {
    "description": "Help Center string: termsSection5Body."
  },
  "termsSection6Title": "6. Termination",
  "@termsSection6Title": {
    "description": "Help Center string: termsSection6Title."
  },
  "termsSection6Body": "You can delete your account at any time from Profile → Edit Profile. We may suspend access for behavior that violates these terms or misuses the service.",
  "@termsSection6Body": {
    "description": "Help Center string: termsSection6Body."
  },
  "termsSection7Title": "7. Changes to These Terms",
  "@termsSection7Title": {
    "description": "Help Center string: termsSection7Title."
  },
  "termsSection7Body": "We may update these terms from time to time. Continuing to use the app after changes means you accept the updated terms.",
  "@termsSection7Body": {
    "description": "Help Center string: termsSection7Body."
  },
  "privacySection1Title": "1. What We Collect",
  "@privacySection1Title": {
    "description": "Help Center string: privacySection1Title."
  },
  "privacySection1Body": "If you use the app as a guest, we don't collect any personal data — your watchlist and favorites are stored only on your device. If you create an account, we collect your name, email address, and (optionally) a profile photo URL via Firebase Authentication.",
  "@privacySection1Body": {
    "description": "Help Center string: privacySection1Body."
  },
  "privacySection2Title": "2. Watchlist and Favorites Data",
  "@privacySection2Title": {
    "description": "Help Center string: privacySection2Title."
  },
  "privacySection2Body": "When signed in, your saved movies are stored in Firestore under your account and synced across your devices. Each account's data is only accessible to that account — enforced by Firestore security rules.",
  "@privacySection2Body": {
    "description": "Help Center string: privacySection2Body."
  },
  "privacySection3Title": "3. Third-Party Services",
  "@privacySection3Title": {
    "description": "Help Center string: privacySection3Title."
  },
  "privacySection3Body": "We use The Movie Database (TMDB) to fetch movie information, and Firebase (Google) for authentication and data storage. These services have their own privacy policies governing how they handle data on their end.",
  "@privacySection3Body": {
    "description": "Help Center string: privacySection3Body."
  },
  "privacySection4Title": "4. Local Storage",
  "@privacySection4Title": {
    "description": "Help Center string: privacySection4Title."
  },
  "privacySection4Body": "Your watchlist, favorites, theme, and language preferences are stored locally on your device (via Hive) so the app works offline and instantly, whether or not you're signed in.",
  "@privacySection4Body": {
    "description": "Help Center string: privacySection4Body."
  },
  "privacySection5Title": "5. Data Deletion",
  "@privacySection5Title": {
    "description": "Help Center string: privacySection5Title."
  },
  "privacySection5Body": "You can delete your account at any time from Profile → Edit Profile, which permanently removes your account and stops any further syncing. Data already stored locally on your device remains until you clear the app's storage.",
  "@privacySection5Body": {
    "description": "Help Center string: privacySection5Body."
  },
  "privacySection6Title": "6. Contact",
  "@privacySection6Title": {
    "description": "Help Center string: privacySection6Title."
  },
  "privacySection6Body": "Questions about this policy? Reach us through Help Center → Contact Us.",
  "@privacySection6Body": {
    "description": "Help Center string: privacySection6Body."
  }
}
